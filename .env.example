# ==============================================================================
# KeyFrame-AI: Environment Configuration Template
# ==============================================================================

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# PostgreSQL Relational Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notes_agent

# Redis (Distributed Rate Limiting & Live Cache)
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (Provider: gemini or openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-3.5-flash
LLM_RATE_LIMIT_RPM=15

# Notion Integration Defaults
NOTION_OAUTH_CLIENT_ID=416d872b-594c-81a8-b82b-0037cbffa15c
NOTION_OAUTH_CLIENT_SECRET=secret_bBIdQ3ygTeRCTyvQsVop91VvezUekI2eOABN6dCI6jj
NOTION_DEFAULT_PARENT_PAGE_ID=4167e1b37a1480e385bfc65f2bb279f8

# Storage & Processing Directory
FRAME_STORAGE_DIR=./frames

# Hard Constraints & Failure Resilience Limits
MAX_VIDEO_DURATION_SEC=1200
MAX_RETRY_ATTEMPTS=5
RETRY_BACKOFF_SCHEDULE=[10, 30, 90]

